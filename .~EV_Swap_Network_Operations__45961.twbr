    <worksheet name='Wait Time by Hour'>
      <table>
        <view>
          <datasources>
            <datasource caption='swap_transactions' name='federated.1dofqpe05q9hcf11nmjnx0py8qc8' />
          </datasources>
          <datasource-dependencies datasource='federated.1dofqpe05q9hcf11nmjnx0py8qc8'>
            <column caption='Hour Number' datatype='integer' name='[Calculation_3158453517602817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEPART(&apos;hour&apos;,[timestamp])' />
            </column>
            <column caption='Average Wait Time' datatype='real' name='[Calculation_3158453521936391]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([wait_minutes])' />
            </column>
            <column caption='Hour Label' datatype='string' name='[Calculation_3158454244143118]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_3158453517602817] = 0 THEN &quot;12 AM&quot;&#10;ELSEIF [Calculation_3158453517602817] &lt; 12 THEN STR([Calculation_3158453517602817]) + &quot; AM&quot;&#10;ELSEIF [Calculation_3158453517602817] = 12 THEN &quot;12 PM&quot;&#10;ELSE STR([Calculation_3158453517602817] - 12) + &quot; PM&quot;&#10;END' />
            </column>
            <column-instance column='[Calculation_3158453517602817]' derivation='Min' name='[min:Calculation_3158453517602817:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3158454244143118]' derivation='None' name='[none:Calculation_3158454244143118:nk]' pivot='key' type='nominal' />
            <column-instance column='[station_name]' derivation='None' name='[none:station_name:nk]' pivot='key' type='nominal' />
            <column caption='Station Name' datatype='string' name='[station_name]' role='dimension' type='nominal' />
            <column caption='Timestamp' datatype='datetime' name='[timestamp]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_3158453521936391]' derivation='User' name='[usr:Calculation_3158453521936391:qk]' pivot='key' type='quantitative' />
            <column caption='Wait Minutes' datatype='real' name='[wait_minutes]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <computed-sort column='[federated.1dofqpe05q9hcf11nmjnx0py8qc8].[none:Calculation_3158454244143118:nk]' direction='ASC' using='[federated.1dofqpe05q9hcf11nmjnx0py8qc8].[min:Calculation_3158453517602817:qk]' />
