      <aliases enabled='yes' />
      <column caption='Swap Date' datatype='date' name='[Calculation_3158453517131776]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE([timestamp])' />
      </column>
      <column caption='Hour Number' datatype='integer' name='[Calculation_3158453517602817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;,[timestamp])' />
      </column>
      <column caption='Day Name' datatype='string' name='[Calculation_3158453518168066]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[timestamp])' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_3158453518827523]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[timestamp])' />
      </column>
      <column caption='Day Type' datatype='string' name='[Calculation_3158453519233028]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATENAME(&apos;weekday&apos;,[timestamp]) = &quot;Saturday&quot;&#10;OR DATENAME(&apos;weekday&apos;,[timestamp]) = &quot;Sunday&quot;&#10;THEN &quot;Weekend&quot;&#10;ELSE &quot;Weekday&quot;&#10;END' />
      </column>
      <column caption='Total Swaps' datatype='integer' name='[Calculation_3158453521510405]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([swap_id])' />
      </column>
      <column caption='Total Revenue' datatype='real' name='[Calculation_3158453521719302]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([payment_amount])' />
      </column>
      <column caption='Average Wait Time' datatype='real' name='[Calculation_3158453521936391]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([wait_minutes])' />
      </column>
      <column caption='Average Swap Duration' datatype='real' name='[Calculation_3158453523337224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([swap_duration_minutes])' />
      </column>
      <column caption='Battery Shortage Event' datatype='integer' name='[Calculation_3158453523636233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF[batteries_available_before_swap] &lt;= 2&#10;THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Battery Shortage Events' datatype='integer' name='[Calculation_3158453524205578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3158453523636233])' />
      </column>
      <column caption='Battery Shortage Rate' datatype='real' name='[Calculation_3158453528150027]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3158453523636233]) / COUNTD([swap_id])' />
      </column>
      <column caption='Total Downtime Hours' datatype='real' name='[Calculation_3158453528891404]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([downtime_minutes]) / 60' />
      </column>
      <column caption='Average Batteries Available' datatype='real' name='[Calculation_3158453529346061]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([batteries_available_before_swap])' />
      </column>
      <column caption='Hour Label' datatype='string' name='[Calculation_3158454244143118]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3158453517602817] = 0 THEN &quot;12 AM&quot;&#10;ELSEIF [Calculation_3158453517602817] &lt; 12 THEN STR([Calculation_3158453517602817]) + &quot; AM&quot;&#10;ELSEIF [Calculation_3158453517602817] = 12 THEN &quot;12 PM&quot;&#10;ELSE STR([Calculation_3158453517602817] - 12) + &quot; PM&quot;&#10;END' />
      </column>
